# Impedir la ejecución de scripts en la carpeta de subidas y permitir solo
# la descarga de los documentos adjuntos.
# Sistema de Gestión de Prácticas Laborales - ITSEC SUCRE

# Deshabilitar el motor PHP en esta carpeta.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Bloquear la ejecución de archivos con extensiones de script.
<FilesMatch "\.(php|php5|phtml|pht|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
