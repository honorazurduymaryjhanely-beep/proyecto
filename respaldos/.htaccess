# Denegar el acceso directo por HTTP a los archivos de respaldo.
# La descarga se realiza únicamente a través de modulos/respaldos/descargar.php
# con validación de sesión y permisos.
# Sistema de Gestión de Prácticas Laborales - ITSEC SUCRE

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
